#!/bin/bash
set -euo pipefail

JPS_VERSION="2.0.0"
JPS_BIN_NAME="jps-32"
JPS_ARCH_BITS="32"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/lib/i18n.sh" ]; then
    LIB_DIR="$SCRIPT_DIR/lib"
elif [ -f "/usr/local/share/jps/lib/i18n.sh" ]; then
    LIB_DIR="/usr/local/share/jps/lib"
else
    echo "JPS lib bulunamadı!" >&2; exit 1
fi

source "$LIB_DIR/i18n.sh"
source "$LIB_DIR/progress.sh"
source "$LIB_DIR/selfupdate.sh"
source "$LIB_DIR/install.sh"

C_RESET="\033[0m"; C_BOLD="\033[1m"; C_CYAN="\033[36m"
C_GREEN="\033[32m"; C_YELLOW="\033[33m"; C_RED="\033[31m"
C_ORANGE="\033[38;5;208m"
C_BLUE="\033[34m"

REPO_URL="https://github.com/xyronixstudios-coder/Jubatus-Repo.git"
INSTALL_DIR="/var/lib/jps-32"

sync_repo() {
    echo -e "${C_CYAN}$(msg repo_sync_start)${C_RESET}"
    if [ ! -d "$INSTALL_DIR" ]; then
        sudo mkdir -p "$INSTALL_DIR"
        sudo chown -R "$USER:$USER" "$INSTALL_DIR"
        echo -e "${C_CYAN}$(msg repo_clone_first)${C_RESET}"
        if ! git clone --quiet "$REPO_URL" "$INSTALL_DIR"; then
            echo -e "${C_RED}$(msg repo_clone_fail)${C_RESET}"; exit 1
        fi
    else
        sudo chown -R "$USER:$USER" "$INSTALL_DIR" >/dev/null 2>&1 || true
        git -C "$INSTALL_DIR" remote set-url origin "$REPO_URL" >/dev/null 2>&1 || true
        git -C "$INSTALL_DIR" config pull.rebase false >/dev/null 2>&1 || true
        echo -e "${C_CYAN}$(msg repo_update)${C_RESET}"
        if ! git -C "$INSTALL_DIR" fetch --quiet origin main 2>/dev/null; then
            echo -e "${C_YELLOW}$(msg repo_update_warn)${C_RESET}"
        else
            git -C "$INSTALL_DIR" reset --hard origin/main >/dev/null 2>&1 || true
        fi
    fi
    echo -e "${C_GREEN}$(msg repo_update_ok)${C_RESET}"
}


remove_package() {
    local pkg="$1"
    echo -e "${C_CYAN}$(msg pkg_remove_start "$pkg")${C_RESET}"
    local found=0
    for f in "/usr/local/bin/$pkg" "/usr/bin/$pkg"; do
        [ -f "$f" ] && { sudo rm -vf "$f"; found=1; }
    done
    if [ "$found" -eq 1 ]; then
        echo -e "${C_GREEN}$(msg pkg_remove_ok "$pkg")${C_RESET}"
    else
        echo -e "${C_YELLOW}$(msg pkg_remove_not_found "$pkg")${C_RESET}"
    fi
}

list_packages() {
    sync_repo >/dev/null 2>&1 || true
    for p in "$dir"/*/; do
        [ -d "$p" ] && basename "$p"
    done
}

search_packages() {
    local kw="$1"
    sync_repo >/dev/null 2>&1 || true
    local dir="$INSTALL_DIR/$JPS_ARCH_BITS-bit"
    [ -d "$dir" ] || return
    echo -e "${C_ORANGE}$(msg search_title "$kw")${C_RESET}"
    for p in "$dir"/*/; do
        [ -d "$p" ] || continue
        local name
        name=$(basename "$p")
        if [[ "$name" == *"$kw"* ]]; then echo "  $name"; fi
    done
}

show_help() {
    echo -e "${C_ORANGE}${C_BOLD}==========================================${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}  $(msg help_title)${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}  Xyronix Studios - Eren Mut${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}==========================================${C_RESET}"
    echo "$(msg help_usage "$JPS_BIN_NAME")"
    echo ""
    echo "$(msg help_cmds)"
    echo "  $(msg help_update)"
    echo "  $(msg help_selfupdate)"
    echo "  $(msg help_submit)"
    echo "  $(msg help_install)"
    echo "  $(msg help_remove)"
    echo "  $(msg help_search)"
    echo "  $(msg help_list)"
    echo "  $(msg help_info)"
    echo "  $(msg help_help)"
    echo -e "${C_ORANGE}==========================================${C_RESET}"
}

info_package() {
    echo -e "${C_ORANGE}${C_BOLD}╔══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}║  JPS-${JPS_ARCH_BITS} - Jubatus Package System${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}╚══════════════════════════════════════╝${C_RESET}"
    echo ""
    echo -e "${C_BOLD}Sürüm:${C_RESET}          $JPS_VERSION"
    echo -e "${C_BOLD}Mimari:${C_RESET}         ${JPS_ARCH_BITS}-bit ($(uname -m))"
    echo -e "${C_BOLD}Dil:${C_RESET}            $JPS_LANG ($(msg lang_name 2>/dev/null || echo "$JPS_LANG"))"
    echo -e "${C_BOLD}Repo:${C_RESET}           $REPO_URL"
    echo -e "${C_BOLD}Kurulum Dizini:${C_RESET}  $INSTALL_DIR"
    echo ""
    if [ -d "$INSTALL_DIR/${JPS_ARCH_BITS}-bit" ]; then
        local pkg_count
        pkg_count=$(find "$INSTALL_DIR/${JPS_ARCH_BITS}-bit" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
        echo -e "${C_BOLD}Mevcut Paket:${C_RESET}     $pkg_count"
    fi
    local installed=()
    for bin in fastfetch btop bat eza rg fzf zoxide lazygit jq tldr htop neofetch nvim delta ncdu chafa cmatrix cowsay yt-dlp btm kivi xyronix-backup; do
        command -v "$bin" >/dev/null 2>&1 && installed+=("$bin")
    done
    echo -e "${C_BOLD}Kurulu:${C_RESET}           ${#installed[@]} paket"
    if [ ${#installed[@]} -gt 0 ]; then
        echo -e "  ${C_GREEN}${installed[*]}${C_RESET}"
    fi
    echo ""
    echo -e "${C_ORANGE}╔══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_ORANGE}║  Xyronix Studios - Eren Mut${C_RESET}"
    echo -e "${C_ORANGE}╚══════════════════════════════════════╝${C_RESET}"
}


submit_project() {
    echo -e "${C_ORANGE}${C_BOLD}╔══════════════════════════════════════╗${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}║  JPS-${JPS_ARCH_BITS} Öğrenci Projesi Gönderimi${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}║  Xyronix Studios Portal${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}╚══════════════════════════════════════╝${C_RESET}"

    while true; do
        echo -en "${C_YELLOW}:: Okul Adını Giriniz: ${C_RESET}"
        read -r raw_school
        [ -n "$raw_school" ] && break
        echo -e "${C_RED}Hata: Okul adı boş bırakılamaz!${C_RESET}"
    done

    school_formatted=$(echo "$raw_school" | tr ' ' '-' | tr '[:lower:]' '[:upper:]')

    while true; do
        echo -en "${C_YELLOW}:: Proje/Dosya Yolunu Giriniz: ${C_RESET}"
        read -r raw_path
        # eval KULLANMA (guvenlik)
        expanded_path=$(realpath -m "$raw_path" 2>/dev/null || echo "$raw_path")
        [ -e "$expanded_path" ] && break
        echo -e "${C_RED}Hata: '$expanded_path' bulunamadı!${C_RESET}"
    done

    echo -e "\n${C_CYAN}:: Gönderim Bilgileri:${C_RESET}"
    echo -e "   Okul Adı   : ${C_GREEN}${C_BOLD}$school_formatted${C_RESET}"
    echo -e "   Proje Yolu : ${C_GREEN}$expanded_path${C_RESET}\n"

    read -p ":: Projeyi göndermek istiyor musunuz? [E/h]: " confirm
    confirm=${confirm:-E}
    [[ ! "$confirm" =~ ^[Ee]$ ]] && { echo -e "${C_YELLOW}:: İptal edildi.${C_RESET}"; return 0; }

    sync_repo
    git -C "$INSTALL_DIR" config user.name "Xyronix Studios Bot" >/dev/null 2>&1
    git -C "$INSTALL_DIR" config user.email "bot@xyronixstudios.internal" >/dev/null 2>&1

    target_dir="$INSTALL_DIR/student-projects/$school_formatted"
    mkdir -p "$target_dir"
    echo -e "${C_CYAN}[JPS-${JPS_ARCH_BITS}] Proje dosyaları kopyalanıyor...${C_RESET}"
    cp -r "$expanded_path" "$target_dir/" 2>/dev/null || cp -r "$expanded_path"* "$target_dir/"

    cd "$INSTALL_DIR" || return 1
    git add student-projects/"$school_formatted"

    if git diff --staged --quiet; then
        echo -e "${C_YELLOW}:: Bu proje zaten sunucuda mevcut.${C_RESET}"
        return 0
    fi

    git commit -m "Proje Gönderimi: $school_formatted" >/dev/null 2>&1
    git -C "$INSTALL_DIR" remote set-url origin "https://github.com/xyronixstudios-coder/Jubatus-Repo.git" >/dev/null 2>&1 || true
    if git push origin main; then
        echo -e "${C_GREEN}${C_BOLD}\n[BAŞARILI] Projeniz 'student-projects/$school_formatted' klasörüne gönderildi!${C_RESET}"
    else
        echo -e "${C_RED}${C_BOLD}\n[HATA] Gönderim başarısız.${C_RESET}"
    fi
}

case "${1:-help}" in
    update)      sync_repo ;;
    submit)      submit_project ;;
    self-update) self_update "$JPS_BIN_NAME" ;;
    rollback)    self_rollback "$JPS_BIN_NAME" ;;
    install)     [ -z "${2:-}" ] && { echo -e "${C_RED}Paket adı gerekli.${C_RESET}"; exit 1; }; install_package "$2" ;;
    remove)      [ -z "${2:-}" ] && { echo -e "${C_RED}Paket adı gerekli.${C_RESET}"; exit 1; }; remove_package "$2" ;;
    search)      [ -z "${2:-}" ] && { echo -e "${C_RED}Arama kelimesi gerekli.${C_RESET}"; exit 1; }; search_packages "$2" ;;
    list)        list_packages ;;
    info)        info_package ;;
    help|*)      show_help ;;
esac
