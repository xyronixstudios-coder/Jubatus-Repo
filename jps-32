#!/bin/bash

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[36m"
C_GREEN="\033[32m"
C_YELLOW="\033[33m"
C_RED="\033[31m"
C_BLUE="\033[34m"

REPO_URL="https://github.com/xyronixstudios-coder/Jubatus-Repo.git"
RAW_JPS_URL="https://raw.githubusercontent.com/xyronixstudios-coder/Jubatus-Repo/main/jps-32"
INSTALL_DIR="/var/lib/jps-32"

sync_repo_silent() {
    if [ ! -d "$INSTALL_DIR" ]; then
        sudo mkdir -p /var/lib
        sudo git clone --quiet "$REPO_URL" "$INSTALL_DIR" >/dev/null 2>&1
    else
        sudo git -C "$INSTALL_DIR" config pull.rebase false >/dev/null 2>&1
        sudo git -C "$INSTALL_DIR" fetch origin main --quiet >/dev/null 2>&1
        sudo git -C "$INSTALL_DIR" reset --hard origin/main --quiet >/dev/null 2>&1
    fi
}

configure_git() {
    local repo_path="$1"
    sudo git -C "$repo_path" config user.name "Xyronix Studios Bot" >/dev/null 2>&1
    sudo git -C "$repo_path" config user.email "bot@xyronixstudios.internal" >/dev/null 2>&1
}

check_and_update() {
    echo -e "${C_CYAN}[JPS-32] Depo ve güncelleme bilgileri kontrol ediliyor...${C_RESET}"
    
    sync_repo_silent

    TARGET_BIN=$(which jps-32 2>/dev/null || echo "/usr/local/bin/jps-32")
    
    TMP_FILE=$(mktemp)
    curl -sSL "$RAW_JPS_URL?v=$(date +%s)" -o "$TMP_FILE" 2>/dev/null || wget -qO "$TMP_FILE" "$RAW_JPS_URL?v=$(date +%s)" 2>/dev/null

    HAS_UPDATE=0
    if [ -f "$TARGET_BIN" ] && [ -f "$TMP_FILE" ]; then
        LOCAL_HASH=$(md5sum "$TARGET_BIN" | awk '{print $1}')
        REMOTE_HASH=$(md5sum "$TMP_FILE" | awk '{print $1}')
        
        if [ "$LOCAL_HASH" != "$REMOTE_HASH" ]; then
            HAS_UPDATE=1
        fi
    fi

    echo -e "${C_GREEN}:: Depo indeksleri güncellendi.${C_RESET}"

    if [ "$HAS_UPDATE" -eq 1 ]; then
        echo -e "${C_YELLOW}${C_BOLD}:: JPS-32 Paket Yöneticisi için yeni bir güncelleme mevcut!${C_RESET}"
        read -p ":: Güncelleme yüklensin mi? [E/h]: " choice
        choice=${choice:-E}
        
        if [[ "$choice" =~ ^[Ee]$ ]]; then
            echo -e "${C_CYAN}[JPS-32] Güncelleniyor...${C_RESET}"
            sudo cp "$TMP_FILE" "$TARGET_BIN"
            sudo chmod +x "$TARGET_BIN"
            rm -f "$TMP_FILE"
            echo -e "${C_GREEN}${C_BOLD}[BAŞARILI] JPS-32 başarıyla en son sürüme güncellendi!${C_RESET}"
        else
            rm -f "$TMP_FILE"
            echo -e "${C_YELLOW}:: Güncelleme iptal edildi.${C_RESET}"
        fi
    else
        rm -f "$TMP_FILE"
        echo -e "${C_BLUE}:: JPS-32 zaten en güncel sürümde.${C_RESET}"
    fi
}

submit_project() {
    echo -e "${C_CYAN}${C_BOLD}"
    echo "============================================="
    echo "    JPS-32 ÖĞRENCİ PROJESİ GÖNDERİMİ        "
    echo "        Xyronix Studios Portal              "
    echo "============================================="
    echo -e "${C_RESET}"

    while true; do
        echo -en "${C_YELLOW}:: Okul Adını Giriniz: ${C_RESET}"
        read -r raw_school
        if [ -n "$raw_school" ]; then
            break
        fi
        echo -e "${C_RED}Hata: Okul adı boş bırakılamaz!${C_RESET}"
    done

    school_formatted=$(echo "$raw_school" | tr ' ' '-' | tr '[:lower:]' '[:upper:]')

    while true; do
        echo -en "${C_YELLOW}:: Proje/Dosya Yolunu Giriniz: ${C_RESET}"
        read -r raw_path
        eval expanded_path="$raw_path"
        
        if [ -e "$expanded_path" ]; then
            break
        fi
        echo -e "${C_RED}Hata: '$expanded_path' bulunamadı! Lütfen geçerli bir yol girin.${C_RESET}"
    done

    echo -e "\n${C_BLUE}:: Gönderim Bilgileri:${C_RESET}"
    echo -e "   Okul Adı   : ${C_GREEN}${C_BOLD}$school_formatted${C_RESET}"
    echo -e "   Proje Yolu : ${C_GREEN}$expanded_path${C_RESET}\n"

    read -p ":: Projeyi göndermek istiyor musunuz? [E/h]: " confirm
    confirm=${confirm:-E}

    if [[ ! "$confirm" =~ ^[Ee]$ ]]; then
        echo -e "${C_YELLOW}:: Gönderim işlemi iptal edildi.${C_RESET}"
        exit 0
    fi

    sync_repo_silent
    configure_git "$INSTALL_DIR"

    target_dir="$INSTALL_DIR/student-project/$school_formatted"
    sudo mkdir -p "$target_dir"

    echo -e "${C_CYAN}[JPS-32] Proje dosyaları kopyalanıyor...${C_RESET}"
    sudo cp -r "$expanded_path" "$target_dir/"

    echo -e "${C_CYAN}[JPS-32] Sunucuya pushlanıyor...${C_RESET}"
    cd "$INSTALL_DIR" || exit 1
    sudo git add student-project/"$school_formatted"

    if sudo git diff --staged --quiet; then
        echo -e "${C_YELLOW}:: Bu proje zaten sunucuda en güncel haliyle mevcut.${C_RESET}"
        return 0
    fi

    sudo git commit -m "Proje Gönderimi: $school_formatted" >/dev/null 2>&1
    
    if sudo git push origin main >/dev/null 2>&1; then
        echo -e "${C_GREEN}${C_BOLD}\n[BAŞARILI] Projeniz '$school_formatted' klasörüne başarıyla gönderildi!${C_RESET}"
    else
        echo -e "${C_RED}${C_BOLD}\n[HATA] Proje gönderilirken bir ağ veya yetki hatası oluştu.${C_RESET}"
    fi
}

show_help() {
    echo -e "${C_CYAN}${C_BOLD}==========================================${C_RESET}"
    echo -e "${C_CYAN}${C_BOLD}      JPS-32 (Jubatus OS Package System)   ${C_RESET}"
    echo -e "${C_CYAN}${C_BOLD}        Xyronix Studios - Eren Mut        ${C_RESET}"
    echo -e "${C_CYAN}${C_BOLD}==========================================${C_RESET}"
    echo "Kullanım: jps-32 <komut> veya jps <komut>"
    echo ""
    echo "Komutlar:"
    echo "  update            - Depoyu senkronize eder ve güncelleme sorar"
    echo "  submit            - Renkli arayüz ile öğrenci projesi gönderir"
    echo "  install <paket>   - 32-bit paketi kurar"
    echo "  remove <paket>    - Paketi sistemden kaldırır"
    echo "  info              - Sistem bilgilerini gösterir"
    echo "  help              - Bu menüyü gösterir"
    echo -e "${C_CYAN}==========================================${C_RESET}"
}

install_package() {
    local pkg="$1"
    sync_repo_silent

    local pkg_path="$INSTALL_DIR/32-bit/$pkg"

    if [ ! -d "$pkg_path" ]; then
        echo -e "${C_RED}Hata: '$pkg' paketi 32-bit deposunda bulunamadı!${C_RESET}"
        exit 1
    fi

    echo -e "${C_CYAN}[JPS-32] $pkg paketi yükleniyor...${C_RESET}"

    if [ -f "$pkg_path/install.sh" ]; then
        cd "$pkg_path" || exit 1
        sudo bash "$pkg_path/install.sh"
        echo -e "${C_GREEN}[BAŞARILI] $pkg paketi başarıyla kuruldu!${C_RESET}"
    elif [ -f "$pkg_path/$pkg" ]; then
        sudo cp "$pkg_path/$pkg" /usr/local/bin/
        sudo chmod +x "/usr/local/bin/$pkg"
        echo -e "${C_GREEN}[BAŞARILI] $pkg başarıyla /usr/local/bin altına kuruldu!${C_RESET}"
    else
        echo -e "${C_RED}Hata: $pkg klasöründe kurulabilir dosya bulunamadı.${C_RESET}"
        exit 1
    fi
}

remove_package() {
    local pkg="$1"
    if [ -f "/usr/local/bin/$pkg" ]; then
        sudo rm -f "/usr/local/bin/$pkg"
        echo -e "${C_GREEN}[BAŞARILI] $pkg sistemden kaldırıldı.${C_RESET}"
    elif [ -f "/usr/bin/$pkg" ]; then
        sudo rm -f "/usr/bin/$pkg"
        echo -e "${C_GREEN}[BAŞARILI] $pkg sistemden kaldırıldı.${C_RESET}"
    else
        echo -e "${C_YELLOW}Uyarı: $pkg çalıştırılabilir dosyası bulunamadı.${C_RESET}"
    fi
}

case "$1" in
    update)
        check_and_update
        ;;
    submit)
        submit_project
        ;;
    install)
        if [ -z "$2" ]; then
            echo -e "${C_RED}Hata: Kurulacak paket adını belirtmelisin!${C_RESET}"
            exit 1
        fi
        install_package "$2"
        ;;
    remove)
        if [ -z "$2" ]; then
            echo -e "${C_RED}Hata: Kaldırılacak paket adını belirtmelisin!${C_RESET}"
            exit 1
        fi
        remove_package "$2"
        ;;
    info)
        echo -e "${C_CYAN}JPS-32 - Jubatus OS Paket Yöneticisi (Xyronix Studios)${C_RESET}"
        ;;
    help|*)
        show_help
        ;;
esac
