#!/bin/bash

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[36m"
C_GREEN="\033[32m"
C_YELLOW="\033[33m"
C_RED="\033[31m"
C_BLUE="\033[34m"

REPO_URL="git@github.com:xyronixstudios-coder/Jubatus-Repo.git"
RAW_JPS_URL="https://raw.githubusercontent.com/xyronixstudios-coder/Jubatus-Repo/main/jps-64"
INSTALL_DIR="/var/lib/jps-64"

sync_repo() {
    echo -e "${C_CYAN}[1/3] Depo indeksleri güncelleniyor...${C_RESET}"
    if [ ! -d "$INSTALL_DIR" ]; then
        sudo mkdir -p /var/lib
        echo -e "${C_BLUE}:: Depo ilk kez klonlanıyor...${C_RESET}"
        if ! sudo git clone --progress "$REPO_URL" "$INSTALL_DIR"; then
            echo -e "${C_RED}[HATA] Depo klonlanamadı! Bağlantınızı kontrol edin.${C_RESET}"
            exit 1
        fi
    else
        # Kökten çözüm: Yerel dizinin remote adresi HTTPS ise SSH'a çevir
        sudo git -C "$INSTALL_DIR" remote set-url origin "$REPO_URL" >/dev/null 2>&1
        sudo git -C "$INSTALL_DIR" config pull.rebase false >/dev/null 2>&1
        echo -e "${C_BLUE}:: Depo güncelleniyor...${C_RESET}"
        if ! sudo git -C "$INSTALL_DIR" fetch origin main --progress; then
            echo -e "${C_YELLOW}[UYARI] Depo senkronize edilemedi, yerel önbellek kullanılacak.${C_RESET}"
        else
            sudo git -C "$INSTALL_DIR" reset --hard origin/main >/dev/null 2>&1
        fi
    fi
    echo -e "${C_GREEN}[+] Depo güncel!${C_RESET}"
}

configure_git() {
    local repo_path="$1"
    sudo git -C "$repo_path" config user.name "Xyronix Studios Bot" >/dev/null 2>&1
    sudo git -C "$repo_path" config user.email "bot@xyronixstudios.internal" >/dev/null 2>&1
}

check_and_update() {
    echo -e "${C_CYAN}[JPS-64] Depo ve güncelleme bilgileri kontrol ediliyor...${C_RESET}"
    
    sync_repo

    TARGET_BIN=$(which jps-64 2>/dev/null || echo "/usr/local/bin/jps-64")
    
    TMP_FILE=$(mktemp)
    echo -e "${C_BLUE}:: Güncelleme kontrol ediliyor...${C_RESET}"
    curl -sSL --progress-bar "$RAW_JPS_URL?v=$(date +%s)" -o "$TMP_FILE" || wget -q --show-progress -O "$TMP_FILE" "$RAW_JPS_URL?v=$(date +%s)"

    HAS_UPDATE=0
    if [ -f "$TARGET_BIN" ] && [ -f "$TMP_FILE" ]; then
        LOCAL_HASH=$(md5sum "$TARGET_BIN" | awk '{print $1}')
        REMOTE_HASH=$(md5sum "$TMP_FILE" | awk '{print $1}')
        
        if [ "$LOCAL_HASH" != "$REMOTE_HASH" ]; then
            HAS_UPDATE=1
        fi
    fi

    if [ "$HAS_UPDATE" -eq 1 ]; then
        echo -e "${C_YELLOW}${C_BOLD}:: JPS-64 Paket Yöneticisi için yeni bir güncelleme mevcut!${C_RESET}"
        read -p ":: Güncelleme yüklensin mi? [E/h]: " choice
        choice=${choice:-E}
        
        if [[ "$choice" =~ ^[Ee]$ ]]; then
            echo -e "${C_CYAN}[JPS-64] Güncelleniyor...${C_RESET}"
            sudo cp "$TMP_FILE" "$TARGET_BIN"
            sudo chmod +x "$TARGET_BIN"
            rm -f "$TMP_FILE"
            echo -e "${C_GREEN}${C_BOLD}[BAŞARILI] JPS-64 başarıyla en son sürüme güncellendi!${C_RESET}"
        else
            rm -f "$TMP_FILE"
            echo -e "${C_YELLOW}:: Güncelleme iptal edildi.${C_RESET}"
        fi
    else
        rm -f "$TMP_FILE"
        echo -e "${C_BLUE}:: JPS-64 zaten en güncel sürümde.${C_RESET}"
    fi
}

submit_project() {
    echo -e "${C_CYAN}${C_BOLD}"
    echo "============================================="
    echo "    JPS-64 ÖĞRENCİ PROJESİ GÖNDERİMİ        "
    echo "        Xyronix Studios Portal              "
    echo "============================================="
    echo -e "${C_RESET}"

    while true; do
        echo -en "${C_YELLOW}:: Okul Adını Giriniz: ${C_RESET}"
        read -r raw_school
        if [ -n "$raw_school" ]; then
            break
        fi
        echo -e "${C_RED}Hata: Okul adı boş bırakılamaz!${C_RESET}"
    done

    school_formatted=$(echo "$raw_school" | tr ' ' '-' | tr '[:lower:]' '[:upper:]')

    while true; do
        echo -en "${C_YELLOW}:: Proje/Dosya Yolunu Giriniz: ${C_RESET}"
        read -r raw_path
        eval expanded_path="$raw_path"
        
        if [ -e "$expanded_path" ]; then
            break
        fi
        echo -e "${C_RED}Hata: '$expanded_path' bulunamadı! Lütfen geçerli bir yol girin.${C_RESET}"
    done

    echo -e "\n${C_BLUE}:: Gönderim Bilgileri:${C_RESET}"
    echo -e "   Okul Adı   : ${C_GREEN}${C_BOLD}$school_formatted${C_RESET}"
    echo -e "   Proje Yolu : ${C_GREEN}$expanded_path${C_RESET}\n"

    read -p ":: Projeyi göndermek istiyor musunuz? [E/h]: " confirm
    confirm=${confirm:-E}

    if [[ ! "$confirm" =~ ^[Ee]$ ]]; then
        echo -e "${C_YELLOW}:: Gönderim işlemi iptal edildi.${C_RESET}"
        exit 0
    fi

    sync_repo
    configure_git "$INSTALL_DIR"

    target_dir="$INSTALL_DIR/student-project/$school_formatted"
    sudo mkdir -p "$target_dir"

    echo -e "${C_CYAN}[JPS-64] Proje dosyaları kopyalanıyor...${C_RESET}"
    sudo cp -r "$expanded_path" "$target_dir/"

    echo -e "${C_CYAN}[JPS-64] Sunucuya pushlanıyor...${C_RESET}"
    cd "$INSTALL_DIR" || exit 1
    sudo git add student-project/"$school_formatted"

    if sudo git diff --staged --quiet; then
        echo -e "${C_YELLOW}:: Bu proje zaten sunucuda en güncel haliyle mevcut.${C_RESET}"
        return 0
    fi

    sudo git commit -m "Proje Gönderimi: $school_formatted" >/dev/null 2>&1
    
    if sudo git push origin main; then
        echo -e "${C_GREEN}${C_BOLD}\n[BAŞARILI] Projeniz '$school_formatted' klasörüne başarıyla gönderildi!${C_RESET}"
    else
        echo -e "${C_RED}${C_BOLD}\n[HATA] Proje gönderilirken bir ağ veya yetki hatası oluştu.${C_RESET}"
    fi
}

install_package() {
    local pkg="$1"
    
    echo -e "${C_CYAN}[JPS-64] '$pkg' paketi kurulum süreci başlatıldı.${C_RESET}"
    sync_repo

    local pkg_path="$INSTALL_DIR/64-bit/$pkg"

    echo -e "${C_CYAN}[2/3] Paket aranıyor: $pkg${C_RESET}"
    if [ ! -d "$pkg_path" ]; then
        echo -e "${C_RED}[HATA] '$pkg' paketi 64-bit deposunda bulunamadı!${C_RESET}"
        echo -e "${C_YELLOW}İpucu: Paket adını doğru yazdığınızdan ve '64-bit/' dizininde mevcut olduğundan emin olun.${C_RESET}"
        exit 1
    fi

    echo -e "${C_GREEN}[+] Paket bulundu: $pkg_path${C_RESET}"
    echo -e "${C_CYAN}[3/3] Paket kuruluyor...${C_RESET}"

    if [ -f "$pkg_path/install.sh" ]; then
        cd "$pkg_path" || exit 1
        echo -e "${C_BLUE}:: 'install.sh' betiği çalıştırılıyor...${C_RESET}"
        if sudo bash "$pkg_path/install.sh"; then
            echo -e "${C_GREEN}${C_BOLD}[BAŞARILI] $pkg paketi başarıyla kuruldu!${C_RESET}"
        else
            echo -e "${C_RED}[HATA] $pkg paketinin kurulum betiği hata döndürdü.${C_RESET}"
            exit 1
        fi
    elif [ -f "$pkg_path/$pkg" ]; then
        echo -e "${C_BLUE}:: İkili dosya /usr/local/bin/ altına kopyalanıyor...${C_RESET}"
        sudo cp -v "$pkg_path/$pkg" /usr/local/bin/
        sudo chmod +x "/usr/local/bin/$pkg"
        echo -e "${C_GREEN}${C_BOLD}[BAŞARILI] $pkg başarıyla /usr/local/bin altına kuruldu!${C_RESET}"
    else
        echo -e "${C_RED}[HATA] $pkg klasöründe 'install.sh' veya çalıştırılabilir dosya bulunamadı.${C_RESET}"
        exit 1
    fi
}

remove_package() {
    local pkg="$1"
    echo -e "${C_CYAN}[JPS-64] $pkg kaldırılıyor...${C_RESET}"
    if [ -f "/usr/local/bin/$pkg" ]; then
        sudo rm -vf "/usr/local/bin/$pkg"
        echo -e "${C_GREEN}[BAŞARILI] $pkg sistemden kaldırıldı.${C_RESET}"
    elif [ -f "/usr/bin/$pkg" ]; then
        sudo rm -vf "/usr/bin/$pkg"
        echo -e "${C_GREEN}[BAŞARILI] $pkg sistemden kaldırıldı.${C_RESET}"
    else
        echo -e "${C_YELLOW}Uyarı: $pkg çalıştırılabilir dosyası sistemde bulunamadı.${C_RESET}"
    fi
}

show_help() {
    echo -e "${C_CYAN}${C_BOLD}==========================================${C_RESET}"
    echo -e "${C_CYAN}${C_BOLD}      JPS-64 (Jubatus OS Package System)   ${C_RESET}"
    echo -e "${C_CYAN}${C_BOLD}        Xyronix Studios - Eren Mut       ${C_RESET}"
    echo -e "${C_CYAN}${C_BOLD}==========================================${C_RESET}"
    echo "Kullanım: jps-64 <komut> veya jps <komut>"
    echo ""
    echo "Komutlar:"
    echo "  update            - Depoyu senkronize eder ve güncelleme sorar"
    echo "  submit            - Renkli arayüz ile öğrenci projesi gönderir"
    echo "  install <paket>   - 64-bit paketi kurar"
    echo "  remove <paket>    - Paketi sistemden kaldırır"
    echo "  info              - Sistem bilgilerini gösterir"
    echo "  help              - Bu menüyü gösterir"
    echo -e "${C_CYAN}==========================================${C_RESET}"
}

case "$1" in
    update)
        check_and_update
        ;;
    submit)
        submit_project
        ;;
    install)
        if [ -z "$2" ]; then
            echo -e "${C_RED}Hata: Kurulacak paket adını belirtmelisin!${C_RESET}"
            exit 1
        fi
        install_package "$2"
        ;;
    remove)
        if [ -z "$2" ]; then
            echo -e "${C_RED}Hata: Kaldırılacak paket adını belirtmelisin!${C_RESET}"
            exit 1
        fi
        remove_package "$2"
        ;;
    info)
        echo -e "${C_CYAN}JPS-64 - Jubatus OS Paket Yöneticisi (Xyronix Studios)${C_RESET}"
        ;;
    help|*)
        show_help
        ;;
esac
