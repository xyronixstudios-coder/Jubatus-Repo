JPS_BIN_NAME="jps-64"
JPS_ARCH_BITS="64"

# ============ Gomulu: lib/i18n.sh ============
#!/bin/bash
# i18n yükleyici - JSON dil dosyalarını okur
# Öncelik: JPS_LANG > LC_ALL > LC_MESSAGES > LANG > en
# Örnek: LANG=tr_TR.UTF-8 -> "tr"

# 1. Dil tespit et
if [ -z "${JPS_LANG:-}" ]; then
    # Sistem dilini al (LC_ALL > LC_MESSAGES > LANG sırası)
    _sys_lang="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
    
    # "tr_TR.UTF-8" -> "tr", "en_US.UTF-8" -> "en"
    _lang_code="${_sys_lang%%_*}"     # alt çizgiden önce
    _lang_code="${_lang_code%%.*}"    # noktadan önce
    _lang_code="${_lang_code%%@*}"    # @ işaretinden önce
    
    # Geçerli mi? (sadece harf, 2-3 karakter)
    if [[ "$_lang_code" =~ ^[a-z]{2,3}$ ]]; then
        JPS_LANG="$_lang_code"
    else
        JPS_LANG="en"
    fi
fi

# 2. Dil dosyası var mı? Yoksa en'e düş
_jps_find_locale_dir() {
    if [ -n "${JPS_LOCALE_DIR:-}" ] && [ -d "$JPS_LOCALE_DIR" ]; then
        echo "$JPS_LOCALE_DIR"; return
    fi
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    if [ -d "$script_dir/locale" ]; then
        echo "$script_dir/locale"; return
    fi
    if [ -d "/usr/local/share/jps/locale" ]; then
        echo "/usr/local/share/jps/locale"; return
    fi
    echo ""
}

JPS_LOCALE_DIR="$(_jps_find_locale_dir)"

# Dil dosyası yoksa ingilizceye düş
if [ ! -f "$JPS_LOCALE_DIR/$JPS_LANG.json" ]; then
    if [ "$JPS_LANG" != "en" ]; then
        # Sessizce en'e düş (kullanıcıya uyarı verme)
        JPS_LANG="en"
    fi
fi

# 3. JSON'dan mesaj oku
_load_json_msg() {
    local key="$1"
    local file="$JPS_LOCALE_DIR/$JPS_LANG.json"
    [ -f "$file" ] || file="$JPS_LOCALE_DIR/en.json"
    [ -f "$file" ] || { echo "$key"; return; }

    if command -v jq >/dev/null 2>&1; then
        jq -r --arg k "$key" '.msg[$k] // $k' "$file" 2>/dev/null
    else
        sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\\(.*\\)\".*/\\1/p" "$file" | head -1
    fi
}

msg() {
    local key="$1"
    shift
    local template
    template=$(_load_json_msg "$key")
    if [ $# -gt 0 ]; then
        printf "$template" "$@"
    else
        printf "%s" "$template"
    fi
}

# ============ Gomulu: lib/progress.sh ============
#!/bin/bash
# JPS Progress Bar - kendi çizen, git çıktısı göstermeyen

_C_RESET="\033[0m"
_C_BOLD="\033[1m"
_C_CYAN="\033[36m"
_C_GREEN="\033[32m"
_C_YELLOW="\033[33m"
_C_RED="\033[31m"
_C_ORANGE="\033[38;5;208m"

_PROGRESS_ACTIVE=0
_PROGRESS_LABEL=""
_PROGRESS_PCT=0

progress_start() {
    _PROGRESS_LABEL="$1"
    _PROGRESS_PCT=0
    _PROGRESS_ACTIVE=1
    _progress_draw
}

progress_set() {
    [ "$_PROGRESS_ACTIVE" -eq 0 ] && return
    local pct="$1"
    [ "$pct" -lt 0 ] && pct=0
    [ "$pct" -gt 100 ] && pct=100
    _PROGRESS_PCT="$pct"
    _progress_draw
}

_progress_draw() {
    local width=30
    local filled=$(( _PROGRESS_PCT * width / 100 ))
    local empty=$(( width - filled ))
    local bar=""
    local i
    for ((i=0; i<filled; i++)); do bar+="█"; done
    for ((i=0; i<empty; i++)); do bar+="░"; done
    printf "\r\033[K  ${_C_ORANGE}⠿${_C_RESET} %-20s [${_C_ORANGE}%s${_C_RESET}] %3d%%" "$_PROGRESS_LABEL" "$bar" "$_PROGRESS_PCT"
}

progress_done() {
    [ "$_PROGRESS_ACTIVE" -eq 0 ] && return
    _PROGRESS_ACTIVE=0
    _PROGRESS_PCT=100
    _progress_draw
    printf "\r\033[K"
    echo -e "  ${_C_GREEN}✓${_C_RESET} ${_C_GREEN}${_C_BOLD}${_PROGRESS_LABEL}${_C_RESET}"
}

progress_fail() {
    [ "$_PROGRESS_ACTIVE" -eq 0 ] && return
    _PROGRESS_ACTIVE=0
    printf "\r\033[K"
    echo -e "  ${_C_RED}✗${_C_RESET} ${_C_RED}${_C_BOLD}${_PROGRESS_LABEL}${_C_RESET}"
}

