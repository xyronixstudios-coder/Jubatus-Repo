#!/bin/bash
set -euo pipefail

C_RESET="\033[0m"; C_BOLD="\033[1m"; C_CYAN="\033[36m"
C_GREEN="\033[32m"; C_YELLOW="\033[33m"; C_RED="\033[31m"; C_BLUE="\033[34m"
C_ORANGE="\033[38;5;208m"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/i18n.sh"
source "$SCRIPT_DIR/lib/progress.sh"
source "$SCRIPT_DIR/lib/selfupdate.sh"

ARCH=$(uname -m)
case "$ARCH" in
    x86_64)  JPS_ARCH="64" ;;
    i?86)    JPS_ARCH="32" ;;
    *)       echo -e "${C_RED}$(msg arch_unsupported "$ARCH")${C_RESET}"; exit 1 ;;
esac

REPO_URL="https://github.com/xyronixstudios-coder/Jubatus-Repo.git"
INSTALL_DIR="/var/lib/jps-$JPS_ARCH"

sync_repo() {
    echo -e "${C_CYAN}$(msg repo_sync_start)${C_RESET}"
    if [ ! -d "$INSTALL_DIR" ]; then
        sudo mkdir -p "$INSTALL_DIR"
        sudo chown -R "$USER:$USER" "$INSTALL_DIR"
        echo -e "${C_BLUE}$(msg repo_clone_first)${C_RESET}"
        if ! git clone --quiet "$REPO_URL" "$INSTALL_DIR"; then
            echo -e "${C_RED}$(msg repo_clone_fail)${C_RESET}"; exit 1
        fi
    else
        sudo chown -R "$USER:$USER" "$INSTALL_DIR" >/dev/null 2>&1 || true
        git -C "$INSTALL_DIR" remote set-url origin "$REPO_URL" >/dev/null 2>&1 || true
        git -C "$INSTALL_DIR" config pull.rebase false >/dev/null 2>&1 || true
        echo -e "${C_BLUE}$(msg repo_update)${C_RESET}"
        # git çıktısını gösterme!
        if ! git -C "$INSTALL_DIR" fetch --quiet origin main 2>/dev/null; then
            echo -e "${C_YELLOW}$(msg repo_update_warn)${C_RESET}"
        else
            git -C "$INSTALL_DIR" reset --hard origin/main >/dev/null 2>&1 || true
        fi
    fi
    echo -e "${C_GREEN}$(msg repo_update_ok)${C_RESET}"
}

install_package() {
    local pkg="$1"
    echo -e "${C_CYAN}$(msg pkg_install_start "$pkg")${C_RESET}"
    sync_repo
    local pkg_path="$INSTALL_DIR/$JPS_ARCH-bit/$pkg"
    echo -e "${C_CYAN}$(msg pkg_search "$pkg")${C_RESET}"
    if [ ! -d "$pkg_path" ]; then
        echo -e "${C_RED}$(msg pkg_not_found "$pkg" "$JPS_ARCH-bit")${C_RESET}"; exit 1
    fi
    echo -e "${C_GREEN}$(msg pkg_found "$pkg_path")${C_RESET}"

    if [ -f "$pkg_path/install.sh" ]; then
        ( cd "$pkg_path" && sudo bash install.sh )
        echo -e "${C_GREEN}${C_BOLD}$(msg pkg_install_ok "$pkg")${C_RESET}"
    elif [ -f "$pkg_path/$pkg" ]; then
        progress_start "$(msg progress_install)"
        sudo cp -f "$pkg_path/$pkg" /usr/local/bin/
        sudo chmod +x "/usr/local/bin/$pkg"
        progress_set 100
        progress_done
        echo -e "${C_GREEN}${C_BOLD}$(msg pkg_install_ok "$pkg")${C_RESET}"
    else
        echo -e "${C_RED}$(msg pkg_install_fail "$pkg")${C_RESET}"; exit 1
    fi
}

remove_package() {
    local pkg="$1"
    echo -e "${C_CYAN}$(msg pkg_remove_start "$pkg")${C_RESET}"
    local found=0
    for f in "/usr/local/bin/$pkg" "/usr/bin/$pkg"; do
        [ -f "$f" ] && { sudo rm -vf "$f"; found=1; }
    done
    if [ "$found" -eq 1 ]; then
        echo -e "${C_GREEN}$(msg pkg_remove_ok "$pkg")${C_RESET}"
    else
        echo -e "${C_YELLOW}$(msg pkg_remove_not_found "$pkg")${C_RESET}"
    fi
}

list_packages() {
    sync_repo >/dev/null 2>&1 || true
    local dir="$INSTALL_DIR/$JPS_ARCH-bit"
    [ -d "$dir" ] || return
    echo -e "${C_CYAN}${C_BOLD}Mevcut paketler ($JPS_ARCH-bit):${C_RESET}"
    for p in "$dir"/*/; do
        [ -d "$p" ] && basename "$p"
    done
}

search_packages() {
    local kw="$1"
    sync_repo >/dev/null 2>&1 || true
    local dir="$INSTALL_DIR/$JPS_ARCH-bit"
    [ -d "$dir" ] || return
    echo -e "${C_CYAN}Arama: $kw${C_RESET}"
    for p in "$dir"/*/; do
        [ -d "$p" ] || continue
        local name
        name=$(basename "$p")
        if [[ "$name" == *"$kw"* ]]; then echo "  $name"; fi
    done
}

show_help() {
    echo -e "${C_ORANGE}${C_BOLD}==========================================${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}  $(msg help_title)${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}  Xyronix Studios - Eren Mut${C_RESET}"
    echo -e "${C_ORANGE}${C_BOLD}==========================================${C_RESET}"
    echo "$(msg help_usage)"
    echo ""
    echo "$(msg help_cmds)"
    echo "  $(msg help_update)"
    echo "  $(msg help_selfupdate)"
    echo "  $(msg help_install)"
    echo "  $(msg help_remove)"
    echo "  $(msg help_search)"
    echo "  $(msg help_list)"
    echo "  $(msg help_info)"
    echo "  $(msg help_help)"
    echo -e "${C_ORANGE}==========================================${C_RESET}"
}

case "${1:-help}" in
    update)      sync_repo ;;
    self-update) self_update ;;
    rollback)    self_rollback ;;
    install)     [ -z "${2:-}" ] && { echo -e "${C_RED}Paket adı gerekli.${C_RESET}"; exit 1; }; install_package "$2" ;;
    remove)      [ -z "${2:-}" ] && { echo -e "${C_RED}Paket adı gerekli.${C_RESET}"; exit 1; }; remove_package "$2" ;;
    search)      [ -z "${2:-}" ] && { echo -e "${C_RED}Arama kelimesi gerekli.${C_RESET}"; exit 1; }; search_packages "$2" ;;
    list)        list_packages ;;
    info)        echo -e "${C_ORANGE}JPS - Jubatus Package System${C_RESET}"; echo "Sürüm: $JPS_VERSION"; echo "Mimari: $ARCH ($JPS_ARCH-bit)"; echo "Dil: $JPS_LANG" ;;
    help|*)      show_help ;;
esac
